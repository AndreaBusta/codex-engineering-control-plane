#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export PYTHONDONTWRITEBYTECODE=1
export PYTHONSAFEPATH=1
if [[ -f "$PROJECT_ROOT/.codex/runtime/codex_control_plane_runtime_v2/cli.py" ]]; then
  export PYTHONPATH="$PROJECT_ROOT/.codex/runtime"
  cd "$PROJECT_ROOT/.codex/runtime"
  exec python3 -P -B -m codex_control_plane_runtime_v2.cli "$@"
fi
export PYTHONPATH="$PROJECT_ROOT"
cd "$PROJECT_ROOT"
exec python3 -P -B -m control_plane.cli "$@"
