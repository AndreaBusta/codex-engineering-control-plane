#!/usr/bin/env python3
"""Build a deterministic, non-authorizing Control Plane release candidate."""

from __future__ import annotations

import argparse
import ast
from hashlib import sha1, sha256
import gzip
from io import BytesIO
import json
import os
from pathlib import Path, PurePosixPath
import re
import secrets
import stat
import subprocess
import sys
import tarfile
import tomllib
from typing import NoReturn


SCRIPT_ROOT = Path(__file__).resolve().parents[1]
if str(SCRIPT_ROOT) not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT))

from control_plane.release_source import (  # noqa: E402
    RELEASE_SOURCE_KIND,
    RELEASE_SOURCE_MARKER,
    RELEASE_SOURCE_MAX_COMMIT_BYTES,
    RELEASE_SOURCE_MAX_ENTRIES,
    RELEASE_SOURCE_MAX_FILE_BYTES,
    RELEASE_SOURCE_MAX_MARKER_BYTES,
    RELEASE_SOURCE_MAX_PATH_BYTES,
    RELEASE_SOURCE_MAX_TOTAL_BYTES,
    RELEASE_SOURCE_MODES,
    RELEASE_SOURCE_OBJECT_FORMAT,
    ReleaseSourceError,
    commit_object_identity,
    encode_commit_object,
    git_tree_oid,
    validate_release_paths,
)


RELEASE_GATES = (
    "adoption-matrix",
    "macos-smoke",
    "release-preflight",
    "verify",
)
GIT_ENVIRONMENT_PREFIX = "GIT_"
VERSION_PATTERN = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$", re.ASCII)
PULL_REQUEST_PATTERN = re.compile(r"\(#([1-9][0-9]*)\)$", re.ASCII)
GITHUB_REMOTE_PATTERNS = (
    re.compile(
        r"^https://github\.com/"
        r"(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?$"
    ),
    re.compile(
        r"^git@github\.com:"
        r"(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?$"
    ),
    re.compile(
        r"^ssh://git@github\.com/"
        r"(?P<owner>[A-Za-z0-9_.-]+)/(?P<repo>[A-Za-z0-9_.-]+?)(?:\.git)?$"
    ),
)


class ReleaseCandidateError(RuntimeError):
    """Closed error surfaced without a traceback or sensitive environment."""


def _fail(code: str, message: str) -> NoReturn:
    raise ReleaseCandidateError(f"{code}: {message}")


def _git_environment() -> dict[str, str]:
    environment = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith(GIT_ENVIRONMENT_PREFIX)
    }
    environment["GIT_NO_REPLACE_OBJECTS"] = "1"
    return environment


def _run_git(repository: Path, *arguments: str, binary: bool = False):
    completed = subprocess.run(
        ["git", "-C", str(repository), *arguments],
        env=_git_environment(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=not binary,
        check=False,
        timeout=30,
    )
    if completed.returncode != 0:
        _fail("E_RELEASE_GIT", f"git {' '.join(arguments[:2])} failed")
    return completed.stdout if binary else completed.stdout.strip()


def _run_git_binary_bounded(
    repository: Path,
    *arguments: str,
    limit: int,
) -> bytes:
    process = subprocess.Popen(
        ["git", "-C", str(repository), *arguments],
        env=_git_environment(),
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    assert process.stdout is not None
    try:
        payload = process.stdout.read(limit + 1)
        if len(payload) > limit:
            process.kill()
            process.wait(timeout=5)
            _fail("E_RELEASE_SOURCE_LIMIT", "Git output exceeds its byte bound")
        return_code = process.wait(timeout=30)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)
        _fail("E_RELEASE_GIT", f"git {' '.join(arguments[:2])} timed out")
    finally:
        process.stdout.close()
    if return_code != 0:
        _fail("E_RELEASE_GIT", f"git {' '.join(arguments[:2])} failed")
    return payload


def _read_git_object(
    repository: Path,
    *,
    object_type: str,
    object_id: str,
    expected_size: int,
    limit: int,
) -> tuple[bytes, str, str]:
    if expected_size < 0 or expected_size > limit:
        _fail("E_RELEASE_SOURCE_LIMIT", "Git object exceeds its byte bound")
    process = subprocess.Popen(
        ["git", "-C", str(repository), "cat-file", object_type, object_id],
        env=_git_environment(),
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    assert process.stdout is not None
    sha256_hasher = sha256()
    sha1_hasher = sha1(usedforsecurity=False)
    sha1_hasher.update(f"{object_type} {expected_size}\0".encode("ascii"))
    chunks: list[bytes] = []
    observed = 0
    try:
        while True:
            chunk = process.stdout.read(min(1024 * 1024, limit + 1 - observed))
            if not chunk:
                break
            observed += len(chunk)
            if observed > limit:
                process.kill()
                process.wait(timeout=5)
                _fail("E_RELEASE_SOURCE_LIMIT", "Git object exceeds its byte bound")
            sha256_hasher.update(chunk)
            sha1_hasher.update(chunk)
            chunks.append(chunk)
        return_code = process.wait(timeout=30)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=5)
        _fail("E_RELEASE_GIT", "git cat-file timed out")
    finally:
        process.stdout.close()
    if return_code != 0 or observed != expected_size:
        _fail("E_RELEASE_SOURCE_IDENTITY", "Git object bytes are inconsistent")
    return b"".join(chunks), sha256_hasher.hexdigest(), sha1_hasher.hexdigest()


def _repository_identity(remote_url: str) -> tuple[str, str]:
    for pattern in GITHUB_REMOTE_PATTERNS:
        matched = pattern.fullmatch(remote_url)
        if matched is not None:
            owner = matched.group("owner")
            repository = matched.group("repo")
            return f"{owner}/{repository}", f"https://github.com/{owner}/{repository}"
    _fail("E_RELEASE_SOURCE", "origin must be an explicit GitHub repository URL")


def _committed_text(repository: Path, commit: str, relative_path: str) -> str:
    try:
        object_id = _run_git(
            repository,
            "rev-parse",
            f"{commit}:{relative_path}",
        )
        size = int(_run_git(repository, "cat-file", "-s", object_id))
        payload, _, observed_oid = _read_git_object(
            repository,
            object_type="blob",
            object_id=object_id,
            expected_size=size,
            limit=RELEASE_SOURCE_MAX_FILE_BYTES,
        )
        if observed_oid != object_id:
            _fail("E_RELEASE_SOURCE_IDENTITY", "release metadata identity is false")
        return payload.decode("utf-8")
    except UnicodeError:
        _fail("E_RELEASE_SOURCE", "committed release metadata is not UTF-8")
    except ValueError:
        _fail("E_RELEASE_SOURCE", "committed release metadata size is invalid")


def _runtime_version(source: str) -> str:
    try:
        parsed = ast.parse(source, filename="control_plane/__init__.py")
    except SyntaxError:
        _fail("E_RELEASE_VERSION", "runtime version source is unavailable")
    versions: list[str] = []
    for statement in parsed.body:
        if not isinstance(statement, ast.Assign):
            continue
        if not any(
            isinstance(target, ast.Name) and target.id == "__version__"
            for target in statement.targets
        ):
            continue
        if isinstance(statement.value, ast.Constant) and isinstance(
            statement.value.value, str
        ):
            versions.append(statement.value.value)
    if len(versions) != 1:
        _fail("E_RELEASE_VERSION", "runtime must declare one literal __version__")
    return versions[0]


def _product_version(repository: Path, commit: str) -> str:
    try:
        lock = tomllib.loads(
            _committed_text(
                repository,
                commit,
                ".codex/control-plane.lock",
            )
        )
    except tomllib.TOMLDecodeError:
        _fail("E_RELEASE_VERSION", "control-plane lock is unavailable")
    version = lock.get("product_version")
    if not isinstance(version, str) or VERSION_PATTERN.fullmatch(version) is None:
        _fail("E_RELEASE_VERSION", "locked product version is invalid")
    if _runtime_version(
        _committed_text(repository, commit, "control_plane/__init__.py")
    ) != version:
        _fail("E_RELEASE_VERSION", "runtime and locked product versions differ")
    return version


def _validate_source(repository: Path) -> tuple[str, str, str, str, str]:
    if repository.is_symlink() or not repository.is_dir():
        _fail("E_RELEASE_SOURCE", "repository must be a real directory")
    if _run_git(repository, "status", "--porcelain=v1"):
        _fail("E_RELEASE_SOURCE", "release source worktree must be clean")
    branch = _run_git(repository, "symbolic-ref", "--quiet", "--short", "HEAD")
    if branch != "main":
        _fail("E_RELEASE_SOURCE", "release source must be the local main branch")
    if _run_git(repository, "rev-parse", "--show-object-format") != RELEASE_SOURCE_OBJECT_FORMAT:
        _fail("E_RELEASE_SOURCE", "release source requires the sha1 Git object format")
    head = _run_git(repository, "rev-parse", "HEAD^{commit}")
    remote_main = _run_git(repository, "rev-parse", "refs/remotes/origin/main^{commit}")
    if head != remote_main:
        _fail("E_RELEASE_SOURCE", "HEAD must equal the observed origin/main")
    tree = _run_git(repository, "rev-parse", "HEAD^{tree}")
    slug, repository_url = _repository_identity(
        _run_git(repository, "remote", "get-url", "origin")
    )
    return head, tree, slug, repository_url, branch


def _validate_workflow_url(workflow_url: str, slug: str) -> None:
    expected = re.compile(
        rf"^https://github\.com/{re.escape(slug)}/actions/runs/[1-9][0-9]*$",
        re.ASCII,
    )
    if expected.fullmatch(workflow_url) is None:
        _fail("E_RELEASE_WORKFLOW", "workflow URL does not bind the source repository")


def _pull_requests(
    repository: Path,
    repository_url: str,
    commit: str,
) -> list[dict[str, object]]:
    subjects = _run_git(repository, "log", "--format=%s", commit).splitlines()
    numbers = sorted(
        {
            int(matched.group(1))
            for subject in subjects
            if (matched := PULL_REQUEST_PATTERN.search(subject)) is not None
        }
    )
    return [
        {"number": number, "url": f"{repository_url}/pull/{number}"}
        for number in numbers
    ]


def _release_source_entries(
    repository: Path, commit: str
) -> list[dict[str, object]]:
    raw_tree = _run_git_binary_bounded(
        repository,
        "ls-tree",
        "-r",
        "-z",
        "-l",
        "--full-tree",
        commit,
        limit=(RELEASE_SOURCE_MAX_ENTRIES + 1)
        * (RELEASE_SOURCE_MAX_PATH_BYTES + 160),
    )
    metadata: list[tuple[str, str, str, int]] = []
    total_bytes = 0
    for record in raw_tree.split(b"\0"):
        if not record:
            continue
        try:
            header, raw_path = record.split(b"\t", 1)
            mode, object_type, object_id, raw_size = header.decode("ascii").split()
            size = int(raw_size)
            path = raw_path.decode("utf-8")
        except (UnicodeError, ValueError):
            _fail("E_RELEASE_SOURCE", "release tree contains an unsupported path")
        if (
            object_type != "blob"
            or mode not in RELEASE_SOURCE_MODES
            or re.fullmatch(r"[0-9a-f]{40}", object_id) is None
        ):
            _fail("E_RELEASE_SOURCE", "release tree contains an unsupported entry")
        if len(metadata) >= RELEASE_SOURCE_MAX_ENTRIES:
            _fail("E_RELEASE_SOURCE_LIMIT", "release source has too many entries")
        if size < 0 or size > RELEASE_SOURCE_MAX_FILE_BYTES:
            _fail("E_RELEASE_SOURCE_LIMIT", "release source blob exceeds its bound")
        total_bytes += size
        if total_bytes > RELEASE_SOURCE_MAX_TOTAL_BYTES:
            _fail("E_RELEASE_SOURCE_LIMIT", "release source exceeds its total byte bound")
        metadata.append((mode, path, object_id, size))
    try:
        validate_release_paths(path for _, path, _, _ in metadata)
    except ReleaseSourceError as error:
        _fail("E_RELEASE_SOURCE_PATH", str(error))

    entries: list[dict[str, object]] = []
    for mode, path, object_id, size in metadata:
        _, sha256_digest, observed_oid = _read_git_object(
            repository,
            object_type="blob",
            object_id=object_id,
            expected_size=size,
            limit=RELEASE_SOURCE_MAX_FILE_BYTES,
        )
        if observed_oid != object_id:
            _fail("E_RELEASE_SOURCE_IDENTITY", "Git blob identity is false")
        entries.append(
            {
                "git_oid": object_id,
                "mode": mode,
                "path": path,
                "sha256": f"sha256:{sha256_digest}",
                "size_bytes": size,
            }
        )
    return sorted(entries, key=lambda item: str(item["path"]))


def _release_source_marker(
    repository: Path,
    *,
    commit: str,
    tree: str,
    version: str,
    entries: list[dict[str, object]],
) -> bytes:
    try:
        observed_tree = git_tree_oid(entries)
    except ReleaseSourceError as error:
        _fail("E_RELEASE_SOURCE_IDENTITY", str(error))
    if observed_tree != tree:
        _fail("E_RELEASE_SOURCE_IDENTITY", "Git tree identity is false")
    try:
        commit_size = int(_run_git(repository, "cat-file", "-s", commit))
    except ValueError:
        _fail("E_RELEASE_SOURCE_IDENTITY", "Git commit size is invalid")
    commit_object, _, _ = _read_git_object(
        repository,
        object_type="commit",
        object_id=commit,
        expected_size=commit_size,
        limit=RELEASE_SOURCE_MAX_COMMIT_BYTES,
    )
    try:
        observed_commit, commit_tree = commit_object_identity(commit_object)
        encoded_commit = encode_commit_object(commit_object)
    except ReleaseSourceError as error:
        _fail("E_RELEASE_SOURCE_IDENTITY", str(error))
    if observed_commit != commit or commit_tree != tree:
        _fail("E_RELEASE_SOURCE_IDENTITY", "Git commit identity is false")
    marker = _json_bytes(
        {
            "entries": entries,
            "product_version": version,
            "release_tag": f"v{version}",
            "schema_version": 1,
            "source_commit": commit,
            "source_commit_object_base64": encoded_commit,
            "source_kind": RELEASE_SOURCE_KIND,
            "source_object_format": RELEASE_SOURCE_OBJECT_FORMAT,
            "source_tree": tree,
        }
    )
    if len(marker) > RELEASE_SOURCE_MAX_MARKER_BYTES:
        _fail("E_RELEASE_SOURCE_LIMIT", "release marker exceeds its byte bound")
    return marker


def _archive_bytes(
    repository: Path,
    prefix: str,
    release_source_marker: bytes,
    entries: list[dict[str, object]],
) -> bytes:
    tar_stream = BytesIO()
    with tarfile.open(
        fileobj=tar_stream,
        mode="w:",
        format=tarfile.PAX_FORMAT,
    ) as archive:
        def add_directory(name: str) -> None:
            directory = tarfile.TarInfo(name)
            directory.type = tarfile.DIRTYPE
            directory.size = 0
            directory.mode = 0o755
            directory.mtime = 0
            directory.uid = 0
            directory.gid = 0
            directory.uname = ""
            directory.gname = ""
            archive.addfile(directory)

        add_directory(prefix)
        directories: set[str] = set()
        for entry in entries:
            parts = PurePosixPath(str(entry["path"])).parts
            for index in range(1, len(parts)):
                directories.add(PurePosixPath(*parts[:index]).as_posix())
        marker_parts = PurePosixPath(RELEASE_SOURCE_MARKER).parts
        for index in range(1, len(marker_parts)):
            directories.add(PurePosixPath(*marker_parts[:index]).as_posix())
        for directory in sorted(
            directories,
            key=lambda value: (len(PurePosixPath(value).parts), value),
        ):
            add_directory(f"{prefix}/{directory}")

        for entry in entries:
            object_id = str(entry["git_oid"])
            size = int(entry["size_bytes"])
            payload, digest, observed_oid = _read_git_object(
                repository,
                object_type="blob",
                object_id=object_id,
                expected_size=size,
                limit=RELEASE_SOURCE_MAX_FILE_BYTES,
            )
            if (
                observed_oid != object_id
                or f"sha256:{digest}" != entry["sha256"]
                or len(payload) != size
            ):
                _fail(
                    "E_RELEASE_SOURCE_IDENTITY",
                    "archive blob no longer matches the release marker",
                )
            member = tarfile.TarInfo(f"{prefix}/{entry['path']}")
            member.size = size
            member.mode = 0o755 if entry["mode"] == "100755" else 0o644
            member.mtime = 0
            member.uid = 0
            member.gid = 0
            member.uname = ""
            member.gname = ""
            archive.addfile(member, BytesIO(payload))

        marker = tarfile.TarInfo(f"{prefix}/{RELEASE_SOURCE_MARKER}")
        marker.size = len(release_source_marker)
        marker.mode = 0o644
        marker.mtime = 0
        marker.uid = 0
        marker.gid = 0
        marker.uname = ""
        marker.gname = ""
        archive.addfile(marker, BytesIO(release_source_marker))
    tar_payload = tar_stream.getvalue()
    archive_limit = (
        RELEASE_SOURCE_MAX_TOTAL_BYTES
        + (RELEASE_SOURCE_MAX_ENTRIES + 1) * 4096
        + RELEASE_SOURCE_MAX_MARKER_BYTES
    )
    if len(tar_payload) > archive_limit:
        _fail("E_RELEASE_SOURCE_LIMIT", "release archive exceeds its byte bound")
    compressed = BytesIO()
    with gzip.GzipFile(
        filename="",
        mode="wb",
        fileobj=compressed,
        compresslevel=9,
        mtime=0,
    ) as stream:
        stream.write(tar_payload)
    return compressed.getvalue()


def _json_bytes(value: object) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")


def _file_record(name: str, payload: bytes) -> dict[str, object]:
    return {
        "name": name,
        "sha256": f"sha256:{sha256(payload).hexdigest()}",
        "size_bytes": len(payload),
    }


def _directory_flags() -> int:
    return (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_CLOEXEC", 0)
    )


def _open_real_directory(path: Path) -> int:
    try:
        resolved = path.resolve(strict=True)
        expected = resolved.stat()
    except OSError:
        _fail("E_RELEASE_OUTPUT", "output parent must be a real existing directory")
    if not resolved.is_absolute():
        _fail("E_RELEASE_OUTPUT", "output parent must be absolute")
    descriptor = os.open(resolved.anchor, _directory_flags())
    try:
        for component in resolved.parts[1:]:
            next_descriptor = os.open(
                component,
                _directory_flags() | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = next_descriptor
        observed = os.fstat(descriptor)
        if (observed.st_dev, observed.st_ino) != (
            expected.st_dev,
            expected.st_ino,
        ):
            _fail("E_RELEASE_OUTPUT", "output parent changed during resolution")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _write_file_at(
    output_descriptor: int,
    name: str,
    payload: bytes,
) -> None:
    temporary_name = f".{name}.{secrets.token_hex(16)}.tmp"
    descriptor = os.open(
        temporary_name,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_NOFOLLOW", 0)
        | getattr(os, "O_CLOEXEC", 0),
        0o644,
        dir_fd=output_descriptor,
    )
    try:
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.rename(
            temporary_name,
            name,
            src_dir_fd=output_descriptor,
            dst_dir_fd=output_descriptor,
        )
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary_name, dir_fd=output_descriptor)
        except OSError:
            pass
        raise


def _directory_identity_at(parent_descriptor: int, name: str) -> tuple[int, int] | None:
    try:
        observed = os.stat(
            name,
            dir_fd=parent_descriptor,
            follow_symlinks=False,
        )
    except OSError:
        return None
    if not stat.S_ISDIR(observed.st_mode):
        return None
    return observed.st_dev, observed.st_ino


def _write_candidate(output: Path, files: dict[str, bytes]) -> None:
    parent_descriptor = _open_real_directory(output.parent)
    output_descriptor: int | None = None
    published: list[str] = []
    created_identity: tuple[int, int] | None = None
    try:
        parent_status = os.fstat(parent_descriptor)
        if (
            parent_status.st_uid != os.geteuid()
            or stat.S_IMODE(parent_status.st_mode) & 0o022
        ):
            _fail(
                "E_RELEASE_OUTPUT",
                "output parent must be owner-controlled and not group/world writable",
            )
        try:
            os.mkdir(output.name, 0o700, dir_fd=parent_descriptor)
        except FileExistsError:
            _fail("E_RELEASE_OUTPUT", "output directory must not already exist")
        created_identity = _directory_identity_at(parent_descriptor, output.name)
        if created_identity is None:
            _fail("E_RELEASE_OUTPUT", "created output directory is unavailable")
        output_descriptor = os.open(
            output.name,
            _directory_flags() | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=parent_descriptor,
        )
        opened = os.fstat(output_descriptor)
        if (opened.st_dev, opened.st_ino) != created_identity:
            _fail("E_RELEASE_OUTPUT", "output directory changed before open")
        for name, payload in files.items():
            _write_file_at(output_descriptor, name, payload)
            published.append(name)
        final_descriptor = os.fstat(output_descriptor)
        if (
            (final_descriptor.st_dev, final_descriptor.st_ino) != created_identity
            or _directory_identity_at(parent_descriptor, output.name)
            != created_identity
        ):
            _fail("E_RELEASE_OUTPUT", "output directory changed during publication")
        os.fsync(output_descriptor)
        os.fsync(parent_descriptor)
    except BaseException:
        if output_descriptor is not None:
            for name in reversed(published):
                try:
                    os.unlink(name, dir_fd=output_descriptor)
                except OSError:
                    pass
        if (
            created_identity is not None
            and _directory_identity_at(parent_descriptor, output.name)
            == created_identity
        ):
            try:
                os.rmdir(output.name, dir_fd=parent_descriptor)
            except OSError:
                pass
        raise
    finally:
        if output_descriptor is not None:
            os.close(output_descriptor)
        os.close(parent_descriptor)


def _resolve_output(repository: Path, supplied: Path) -> Path:
    output = supplied.absolute()
    if output.name in {"", ".", ".."} or output.is_symlink() or output.exists():
        _fail("E_RELEASE_OUTPUT", "output directory must not already exist")
    try:
        parent = output.parent.resolve(strict=True)
    except OSError:
        _fail("E_RELEASE_OUTPUT", "output parent must be a real existing directory")
    resolved = parent / output.name
    if resolved == repository or repository in resolved.parents:
        _fail("E_RELEASE_OUTPUT", "output must remain outside the source repository")
    return resolved


def build_candidate(repository: Path, output: Path, workflow_url: str) -> dict[str, object]:
    repository = repository.resolve(strict=True)
    output = _resolve_output(repository, output)
    source = _validate_source(repository)
    head, tree, slug, repository_url, branch = source
    _validate_workflow_url(workflow_url, slug)
    version = _product_version(repository, head)
    tag = f"v{version}"
    stem = f"codex-engineering-control-plane-{version}"
    archive_name = f"{stem}.tar.gz"
    manifest_name = f"{stem}.manifest.json"
    receipt_name = f"{stem}.receipt.json"
    release_source_entries = _release_source_entries(repository, head)
    release_source_marker = _release_source_marker(
        repository,
        commit=head,
        tree=tree,
        version=version,
        entries=release_source_entries,
    )
    archive = _archive_bytes(
        repository,
        stem,
        release_source_marker,
        release_source_entries,
    )
    archive_record = {
        **_file_record(archive_name, archive),
        "media_type": "application/gzip",
    }
    pull_requests = _pull_requests(repository, repository_url, head)
    gates = [
        {"name": name, "result": "pending_external_evidence"}
        for name in RELEASE_GATES
    ]
    manifest = {
        "schema_version": 1,
        "release_tag": tag,
        "product_version": version,
        "source": {
            "repository": repository_url,
            "remote": "origin",
            "base_branch": branch,
            "commit": head,
            "tree": tree,
            "pull_requests": pull_requests,
        },
        "workflow": {"url": workflow_url, "event": "workflow_dispatch"},
        "gates": gates,
        "artifacts": [archive_record],
        "authorizes": False,
    }
    latest_pull_request = pull_requests[-1]["url"] if pull_requests else ""
    receipt = {
        "schema_version": 1,
        "status": "candidate",
        "source": {
            "repository": repository_url,
            "base_branch": branch,
            "commit": head,
            "pull_request_url": latest_pull_request,
            "merge_commit": head,
        },
        "artifact": {
            "kind": "source-tarball",
            "version": version,
            "build": tag,
            "workflow_url": workflow_url,
            "archive_sha256": archive_record["sha256"],
        },
        "verification": {
            "required_gates": [gate["name"] for gate in gates],
            "external_state": "pending_external_evidence",
            "smoke_result": "pending_external_evidence",
            "observed_at_utc": "",
        },
        "approvals": {
            "release_authorized": False,
            "authorized_by": "",
            "authorized_at_utc": "",
        },
    }
    manifest_bytes = _json_bytes(manifest)
    receipt_bytes = _json_bytes(receipt)
    checksums = (
        f"{archive_record['sha256'].removeprefix('sha256:')}  {archive_name}\n"
    ).encode("ascii")
    files = {
        "SHA256SUMS": checksums,
        manifest_name: manifest_bytes,
        receipt_name: receipt_bytes,
        archive_name: archive,
    }
    if _validate_source(repository) != source:
        _fail("E_RELEASE_SOURCE", "release source changed during candidate build")
    _write_candidate(output, files)
    return {
        "ok": True,
        "release_tag": tag,
        "source_commit": head,
        "source_tree": tree,
        "workflow_url": workflow_url,
        "authorizes": False,
        "files": [
            _file_record(name, payload) for name, payload in sorted(files.items())
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Build a deterministic, non-authorizing release candidate."
    )
    parser.add_argument("--repo", default=".")
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--workflow-url", required=True)
    arguments = parser.parse_args()
    try:
        result = build_candidate(
            Path(arguments.repo),
            Path(arguments.output_dir),
            arguments.workflow_url,
        )
    except (OSError, ReleaseCandidateError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        return 1
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
